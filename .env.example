# Fusion — copy to `.env` and fill in. Never commit your real `.env`.
# Every value below is a placeholder; nothing here ties to any account.

FUSION_MODELS=   # path to an adapter exporting { author, crossWatch, judge }; blank = built-in echo model
FUSION_DATA_DIR=   # optional override for the ./data cache directory; blank = <repo>/data
FUSION_DELEGATE=   # set to 0 to disable the delegate lane (force spec/full for everything)
